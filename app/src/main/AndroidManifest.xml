<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- La sesión sobre pantalla virtual no usa MediaProjection y necesita otro tipo de servicio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Comandos de voz durante la sesión: con la app en segundo plano el micrófono solo entrega
         audio a un servicio en primer plano de tipo microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- El cliente adb embebido abre un socket contra el adbd local (depuración inalámbrica). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para encender la depuración inalámbrica sola al tocar INICIAR. WRITE_SECURE_SETTINGS no se
         concede con un diálogo: CeluVR se lo concede a sí misma por adb (pm grant) la primera vez que
         conecta, y de ahí en más puede encender la depuración inalámbrica sin la computadora. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- El Cardboard SDK declara estos permisos para escanear el QR del visor y detectarlo por
         NFC. Sin perfil de visor el SDK usa los parámetros de Cardboard V1, así que nada de eso
         corre y el usuario no tiene por qué ver un pedido de cámara. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.NFC" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- El panel del visor lista todas las apps lanzables; sin esto Android 11+ solo devuelve
         algunas. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CeluVR"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CeluVR.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PanelActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CeluVR" />
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection|specialUse|microphone"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Muestra en un visor de realidad virtual las apps abiertas en una pantalla virtual propia" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Recibe el binder del proceso servidor propio (lanzado con app_process por adb). El servidor
             corre como shell; el provider valida que quien llama sea shell. -->
        <provider
            android:name=".vdisplay.VDisplayReceiverProvider"
            android:authorities="${applicationId}.vdisplay"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <service
            android:name=".JoystickAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/joystick_accessibility_service_config" />
        </service>
        <activity android:name="com.google.cardboard.sdk.QrCodeCaptureActivity" tools:node="remove" />
        <activity android:name="com.google.cardboard.sdk.HeadsetDetectionActivity" tools:node="remove" />
    </application>

</manifest>